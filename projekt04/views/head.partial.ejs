<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <header>
    <nav>
      <div class="brand">
        <a href="/">Home</a>
        <a href="/przepisy" class="nav-recipe-link">Przepisy</a>
      </div>
      <div class="nav-links">
        <% if (user) { %>
          <span class="user-greeting">👤 <%= user.username %></span>
          <a href="/auth/logout" class="button">Wyloguj</a>
        <% } else { %>
          <a href="/auth/login" class="button">Zaloguj</a>
          <a href="/auth/signup" class="button">Rejestracja</a>
        <% } %>
      </div>
    </nav>
  </header>