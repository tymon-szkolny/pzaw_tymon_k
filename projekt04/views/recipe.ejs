<%- include("head.partial.ejs") %>

<main>
  <h1><%= title %></h1>

  <div>
    <strong>Czas:</strong> <%= recipe.time %>
  </div>

  <div class="recipe-section">
    <h2>Składniki</h2>
    <pre class="recipe-text"><%= recipe.ingredients %></pre>
  </div>

  <div class="recipe-section">
    <h2>Przygotowanie</h2>
    <pre class="recipe-text"><%= recipe.steps %></pre>
  </div>

  <div class="recipe-section">
    <% 
      const isOwner = user && recipe.owner_id != null && Number(user.id) === Number(recipe.owner_id);
    %>
    <strong>Właściciel:</strong>
    <% if (isOwner) { %>
      Ty
    <% } else if (recipe.owner_username) { %>
      <%= recipe.owner_username %>
    <% } else { %>
      —
    <% } %>
  </div>

  <div class="recipe-actions">
    <a href="/przepisy/<%= category.slug %>">Powrót do listy</a>

    <% if (user && (user.username === "admin" || Number(user.id) == Number(recipe.owner_id))) { %>
      <span class="divider">|</span>
      <a href="/przepisy/<%= category.slug %>/edit/<%= recipe.id %>">Edytuj</a>
      <form action="/przepisy/<%= category.slug %>/delete/<%= recipe.id %>" method="POST" class="inline-form">
        <button type="submit" onclick="return confirm('Usuń przepis?')">Usuń</button>
      </form>
    <% } %>
  </div>
</main>

<%- include("foot.partial.ejs") %>